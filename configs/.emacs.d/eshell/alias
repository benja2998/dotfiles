alias tb vterm
alias gf git fetch
alias gpl git pull --rebase
alias gpt git push --tags
alias ll ls -larth $*
alias ff find-file $1
alias e find-file-other-window $1
alias d dired $1
alias gd (call-interactively 'vc-root-diff)
alias gc git commit -m $*
alias gp git push
alias ga git add -A
alias gsh git show $*
alias gs git status
alias ytsdl ytns --print-to-file "before_dl:%(id)s  # [Duration (H.M.S): %(duration>%H.%M.%S)s] %(title)s" search.txt --default-search "ytsearch5:" $*
alias ytsearch yt-dlp --no-download --print-to-file "before_dl:%(id)s  # [Duration (H.M.S): %(duration>%H.%M.%S)s] %(title)s" search.txt --default-search "ytsearch5:" $* >/dev/null; cat search.txt; rm search.txt
alias ytns yt-dlp --sponsorblock-remove all $*
alias clear clear-scrollback
alias cls clear-scrollback
alias gl vc-print-root-log
alias gt git tag $*
