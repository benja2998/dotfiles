# Menu
menu.border.color: #fcfcfc

menu.title.bg: Solid Flat
menu.title.bg.color: #202326
menu.title.bg.shadow: 0
menu.title.text.color: #fcfcfc
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #202326
menu.items.text.color: #fcfcfc
menu.items.disabled.text.color: #c5c5c6

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #ff0000
menu.items.active.text.color: #fcfcfc

menu.separator.color: #c5c5c6
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #202326

# Active window
window.active.border.color: #ff0000


window.active.title.bg: flat solid
window.active.title.bg.color: #202326
window.active.title.separator.color: #202326
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #fcfcfc

window.active.handle.bg: flat solid
window.active.handle.bg.color: #202326

window.active.grip.bg: flat solid
window.active.grip.bg.color: #202326

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #202326
window.active.button.unpressed.image.color: #fcfcfc

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #ff0000
window.active.button.pressed.image.color: #fcfcfc

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #202326
window.active.button.disabled.image.color: #c5c5c6

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #202326
window.active.button.hover.image.color: #ff0000

#window.active.button.toggled.bg: #ff0000
#window.active.button.toggled.image.color: #fcfcfc

# Inactive window
window.inactive.border.color: #a52a2a

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #202326
window.inactive.title.separator.color: #202326
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #c5c5c6

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #202326

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #202326

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #202326
window.inactive.button.unpressed.image.color: #c5c5c6

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #ff0000
window.inactive.button.pressed.image.color: #fcfcfc

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #c5c5c6
window.inactive.button.disabled.image.color: #202326

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #202326
window.inactive.button.hover.image.color: #ff0000


# OSD
osd.border.width: 1
osd.border.color: #ff0000

osd.bg: flat solid
osd.bg.color: #202326
osd.label.bg: flat solid
osd.label.bg.color: #202326
osd.label.text.color: #fcfcfc

# OSD
osd.bg: Solid Flat
osd.bg.color: #202326
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #ff0000
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #202326

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #141618
#osd.button.unpressed.*.border.color: #fcfcfc

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #ff0000
#osd.button.pressed.*.border.color: #fcfcfc

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #fcfcfc
#osd.button.focused.*.border.color: #202326

osd.button.focused.box.color: #ff0000


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
