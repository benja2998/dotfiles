#!/bin/bash

set -ex

if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    if [[ "$NAME" = "Void" ]]; then
	sudo xbps-install \
	     gnupg \
	     git \
	     base-devel \
	     cowsay \
	     fortune-mod \
	     lolcat-c \
	     starship \
	     zoxide
    fi
elif [[ -v PREFIX ]]; then
    pkg i -y x11-repo
    pkg i -y termux-services \
	gnupg \
	git \
	build-essential \
	emacs-x \
	fortune \
	cowsay \
	zoxide
fi

mkdir -p ~/.gnupg
mkdir -p ~/.config

# gsettings set org.gnome.desktop.default-applications.terminal exec 'st'

dotfiles="$(pwd)"

# dconf load /org/gnome/desktop/ < desktop.dconf
# dconf load /org/gnome/shell/ < shell.dconf

rm -r ~/.config/fish
stow -v --target ~ configs
mkdir -p ~/.config/gtk-4.0
mkdir -p ~/.emacs.d/eshell
# cp "$dotfiles/manualcopy/gtk-4.0/gtk.css" ~/.config/gtk-4.0/gtk.css

starship preset no-nerd-font -o ~/.config/starship.toml || true

command -v termux-reload-settings && termux-reload-settings || true
