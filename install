#!/bin/bash

set -ex

if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    if [[ "$NAME" = "Void" ]]; then
	sudo xbps-install gnupg git base-devel emacs-x11
    fi
elif [[ -v PREFIX ]]; then
    pkg i -y x11-repo
    pkg i -y termux-services gnupg git build-essential emacs-x
fi

mkdir -p ~/.gnupg
mkdir -p ~/.config

dotfiles="$(pwd)"

stow -v --target ~ configs
