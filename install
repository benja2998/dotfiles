#!/bin/bash

set -ex

if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    if [[ "$NAME" = "Void" ]]; then
	sudo xbps-install gnupg git base-devel vim-huge tmux fzf ripgrep emacs-pgtk
    fi
elif [[ -v "$PREFIX" ]]; then
    pkg i -y termux-services gnupg git build-essential x11-repo ripgrep tmux fzf
    pkg i -y emacs-x vim-gtk
fi

mkdir -p ~/.gnupg

# gsettings set org.gnome.desktop.default-applications.terminal exec 'st'

dotfiles="$(pwd)"

# dconf load /org/gnome/desktop/ < desktop.dconf
# dconf load /org/gnome/shell/ < shell.dconf

stow -v --target ~ configs
